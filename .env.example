# hf_endpoint (Hugging Face Inference Providers) | hf_local (transformers on your machine) | fake (offline)
LLM_PROVIDER=hf_endpoint

# Get a token at https://huggingface.co/settings/tokens (permission: "Make calls to Inference Providers")
HF_TOKEN=hf_xxx

# Any chat model available on Hugging Face Inference Providers
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_INFERENCE_PROVIDER=auto

# Used when LLM_PROVIDER=hf_local
HF_LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

TEMPERATURE=0.7
MAX_NEW_TOKENS=512

# How many recent messages are sent to the model each turn (all are stored)
MEMORY_WINDOW=20

DATABASE_URL=sqlite:///./chatbot.db
