# hf_endpoint (Hugging Face Inference Providers) | hf_local (transformers on your machine) | fake (offline)
LLM_PROVIDER=hf_endpoint

# Get a token at https://huggingface.co/settings/tokens (permission: "Make calls to Inference Providers")
HF_TOKEN=hf_xxx

# Comma-separated fallback chain: the first model that works is used.
# Find served models at https://huggingface.co/models?inference_provider=all&pipeline_tag=text-generation
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct,deepseek-ai/DeepSeek-V3-0324,moonshotai/Kimi-K2-Instruct,openai/gpt-oss-20b
HF_INFERENCE_PROVIDER=auto

# Used when LLM_PROVIDER=hf_local
HF_LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

TEMPERATURE=0.7
MAX_NEW_TOKENS=1024

# How many recent messages are sent to the model each turn (all are stored)
MEMORY_WINDOW=20

DATABASE_URL=sqlite:///./chatbot.db

# Secret for signing login tokens. Leave empty to auto-generate one into .secret_key
JWT_SECRET=
TOKEN_TTL_HOURS=168
